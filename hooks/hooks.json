{
  "description": "Start the Codex quota menu bar app when a local Codex session starts or resumes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"${PLUGIN_ROOT}/hooks/session_start.py\"",
            "timeout": 120,
            "async": true,
            "statusMessage": "正在启动 Codex 额度菜单栏"
          }
        ]
      }
    ]
  }
}
